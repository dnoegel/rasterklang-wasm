{
  "name": "rasterklang-wasm",
  "version": "0.1.0",
  "description": "Browser SDK for playing Commodore 64 SID tunes with Rasterklang WebAssembly.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnoegel/rasterklang-wasm.git"
  },
